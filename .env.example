# Supabase browser auth (Google provider must be enabled in Supabase Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Optional direct Postgres connection for persistent catalogue, users and orders
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Google Identity Services fallback (only needed if not using Supabase OAuth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Order email delivery
MAILGUN_API_KEY=key-your-mailgun-key
MAILGUN_DOMAIN=mg.your-domain.com
MAILGUN_FROM=KOKO MARKET <orders@mg.your-domain.com>
MAILGUN_REGION=US

# Set a long random value in Vercel so signed sessions survive function invocations
SESSION_SECRET=replace-with-a-long-random-secret
